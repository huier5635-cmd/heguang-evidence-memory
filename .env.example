# Generate locally. Never commit a populated .env or paste secrets into chat.
AML_API_KEY=
AML_MODE=lexical
AML_DATA_DIR=/app/data
AML_MAX_CONCURRENCY=4
AML_CHUNK_CHARS=1800
AML_OVERLAP_CHARS=200
AML_BRIDGE_WEIGHT=0.15
# hybrid and research modes ONLY; no model calls occur in lexical mode.
AML_EMBEDDING_KEY=
AML_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# research mode ONLY. Academic model name is fixed to gpt-4o-mini.
AML_LLM_KEY=
AML_LLM_PROVIDER=openai
AML_LLM_URL=https://api.openai.com/v1

# Optional Vercel route: same prescribed gpt-4o-mini; account/credits required.
# AML_LLM_PROVIDER=vercel
# AML_LLM_URL=https://ai-gateway.vercel.sh/v1
# Store actual keys only in your protected runtime environment, never here.

