# Public diagnostic candidate, not an official frozen submission.
# Compare with baseline defaults on independent data before Full.
AML_MODE=lexical
AML_WINDOW_STRIDE=4
AML_COMPACT_HEADERS=1
AML_BRIDGE_WEIGHT=0
# Use a new persistent directory; do not reuse an index created with different settings.
AML_DATA_DIR=data/compact-candidate
# Set a random AML_API_KEY locally; never use public example/test credentials.
AML_API_KEY=

