[Unit]
Description=Heguang Coding Memory retention independent of API

[Service]
Type=oneshot
User=admin
Group=admin
WorkingDirectory=/opt/heguang-coding/app
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/heguang-coding/app
ExecStart=/opt/heguang-coding/venv/bin/python /opt/heguang-coding/app/deploy/purge_coding.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/heguang-coding
UMask=0077
MemoryMax=512M
